[Unit]
Description=Jellyfin

[Container]
Image=lscr.io/linuxserver/jellyfin:latest
ContainerName=jellyfin
Network=mediaserver.network
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Helsinki
Environment=NVIDIA_DRIVER_CAPABILITIES=comp
Volume=%h/mediaserver/%N:/config
Volume=%h/mediaserver/data/Series:/data/tvshows
Volume=%h/mediaserver/data/Movies:/data/movies
PublishPort=8096:8096

[Service]
Restart=always

[Install]
WantedBy=default.target
