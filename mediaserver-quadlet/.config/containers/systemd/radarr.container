[Unit]
Description=Radarr

[Container]
Image=lscr.io/linuxserver/radarr:latest
ContainerName=radarr
Network=mediaserver.network
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Helsinki
Volume=%h/mediaserver/%N:/config
Volume=/srv/content/Movies:/movies
Volume=/srv/downloads:/downloads
PublishPort=7878:7878

[Service]
Restart=always

[Install]
WantedBy=default.target
