[Unit]
Description=Bazarr

[Container]
Image=lscr.io/linuxserver/bazarr:latest
ContainerName=bazarr
Network=mediaserver.network
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Helsinki
Volume=%h/mediaserver/%N:/config
Volume=%h/mediaserver/data/Series:/tv
Volume=%h/mediaserver/data/Movies:/movies
PublishPort=6767:6767

[Service]
Restart=always

[Install]
WantedBy=default.target
