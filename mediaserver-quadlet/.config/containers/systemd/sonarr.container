[Unit]
Description=Sonarr

[Container]
Image=lscr.io/linuxserver/sonarr:latest
ContainerName=sonarr
Network=mediaserver.network
Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Europe/Helsinki
Volume=%h/mediaserver/%N:/config
Volume=%h/mediaserver/data/Series:/tv
Volume=%h/mediaserver/downloads:/downloads
PublishPort=8989:8989

[Service]
Restart=always

[Install]
WantedBy=default.target
